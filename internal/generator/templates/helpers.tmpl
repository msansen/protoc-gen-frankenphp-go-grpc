func frankenPHPMap(v any) (map[string]any, error) {
	if a, ok := v.({{ .AssociativeArray }}); ok { return a.Map, nil }
	if m, ok := v.(map[string]any); ok { return m, nil }
	return nil, {{ .Errorf }}("expected PHP associative array, got %T", v)
}
func frankenPHPList(v any) ([]any, error) { if x,ok:=v.([]any);ok{return x,nil}; return nil, {{ .Errorf }}("expected PHP list, got %T",v) }
func frankenPHPResponseSlice(v any,key string)([]any,error){m,e:=frankenPHPMap(v);if e!=nil{return nil,e};return frankenPHPList(m[key])}
func frankenPHPString(v any)(string,error){if x,ok:=v.(string);ok{return x,nil};return "",{{ .Errorf }}("expected string, got %T",v)}
func frankenPHPBytes(v any)([]byte,error){x,e:=frankenPHPString(v);return []byte(x),e}
func frankenPHPBool(v any)(bool,error){if x,ok:=v.(bool);ok{return x,nil};return false,{{ .Errorf }}("expected bool, got %T",v)}
func frankenPHPInt64(v any)(int64,error){switch x:=v.(type){case int64:return x,nil;case int:return int64(x),nil;case int32:return int64(x),nil;case uint32:return int64(x),nil;case float64:return int64(x),nil};return 0,{{ .Errorf }}("expected integer, got %T",v)}
func frankenPHPUint64(v any)(uint64,error){switch x:=v.(type){case string:return {{ .ParseUint }}(x,10,64);case int64:if x<0{return 0,{{ .Errorf }}("negative unsigned integer")};return uint64(x),nil;case uint64:return x,nil;case uint32:return uint64(x),nil};return 0,{{ .Errorf }}("expected unsigned integer/string, got %T",v)}
func frankenPHPFloat64(v any)(float64,error){switch x:=v.(type){case float64:return x,nil;case float32:return float64(x),nil;case int64:return float64(x),nil};return 0,{{ .Errorf }}("expected float, got %T",v)}
